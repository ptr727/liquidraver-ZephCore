/*
 * SPDX-License-Identifier: MIT
 * Elecrow ThinkNode M7 — ESP32-S3, 8MB flash, 8MB PSRAM
 *
 * Hardware:
 *   MCU:      ESP32-S3 bare die with external flash (no WROOM module)
 *   Flash:    8 MB, QIO
 *   PSRAM:    8 MB, OPI octal
 *   Radio:    Semtech LR1110 on SPI2 (TCXO 1.8V, DIO5/DIO6 RF switch)
 *   Ethernet: WCH CH390 on SPI3, optional PoE (declared in board.overlay)
 *   Console:  CH343 USB-UART bridge into uart0
 *
 * Not fitted: display, GNSS, buzzer, battery, SD card, reset button.
 *
 * The LR1110 node lives HERE (not board.overlay) so the standalone
 * tools/lr1110_updater build — which replaces board.overlay with its own
 * minimal overlay — still sees the radio.
 */

/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include "thinknode_m7-pinctrl.dtsi"
#include <espressif/partitions_0x0_default_8M.dtsi>
/* In the base DTS (not only board.overlay) so the sysbuild MCUboot image, which
 * sees this file but not board.overlay, also gets a zephyr,console. */
#include "../../common/esp32s3_console_uart0.dtsi"

/ {
	model = "Elecrow ThinkNode M7";
	compatible = "elecrow,thinknode-m7";

	/* No zephyr,console here: the USB-C data lines ride a CH343 USB-UART
	 * bridge into UART0, and the native USB pads are not bonded to the
	 * connector. esp32s3_console_uart0.dtsi supplies the chosen node. */
	chosen {
		zephyr,sram = &sram1;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	aliases {
		uart-0 = &uart0;
		i2c-0 = &i2c0;
		watchdog0 = &wdt0;
		lora0 = &lora;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&spi2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";

	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;

	lora: lora@0 {
		compatible = "semtech,lr1110";
		reg = <0>;
		spi-max-frequency = <8000000>;

		reset-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;                     /* GPIO39 */
		busy-gpios  = <&gpio0 13 GPIO_ACTIVE_HIGH>;                   /* GPIO13 */
		irq-gpios   = <&gpio1 6 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>; /* GPIO38 */

		/* TCXO 1.8V via DIO3 (Arduino LR11X0_DIO3_TCXO_VOLTAGE=1.8) */
		tcxo-voltage = <1800>;
		tcxo-power-startup-delay-ms = <5>;

		rx-boosted;

		/* RF switch truth table from the Arduino rfswitch_table[]:
		 * bit0 = DIO5, bit1 = DIO6.
		 *   STBY: DIO5=L DIO6=L   RX:    DIO5=H DIO6=L
		 *   TX:   DIO5=H DIO6=H   TX_HP: DIO5=L DIO6=H
		 * (MODE_TX = low-power PA path, MODE_TX_HP = high-power PA path) */
		rfsw-enable = <0x03>;
		rfsw-standby = <0x00>;
		rfsw-rx = <0x01>;
		rfsw-tx = <0x03>;
		rfsw-tx-hp = <0x02>;
		rfsw-gnss = <0x00>;
	};
};

/*
 * SPI3 — WCH CH390 Ethernet. 20 MHz: the part is rated 50 MHz typical and
 * 72 MHz maximum at 3.3V (CH390DS1 v1.8), so the ceiling here is not the chip
 * but the GPIO matrix, since these pads have no SPI3 IOMUX route. 20 MHz is
 * proven on this board and is far more than the companion protocol needs.
 */
&spi3 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim3_default>;
	pinctrl-names = "default";

	cs-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;

	eth: ethernet@0 {
		compatible = "wch,ch390";
		reg = <0>;
		spi-max-frequency = <20000000>;

		/* GPIO45 is the VDD_SPI strapping pin and must read LOW at boot, or
		 * the chip picks a 1.8V flash supply and the 3.3V flash browns out.
		 * The driver programs the controller's INTCR polarity from these
		 * flags, and active-high is INTCR's reset value, so the line idles
		 * low both before and after the driver runs. Active-low would boot
		 * once and then hang: the CH390 has no reset input, so it would keep
		 * driving the pin high across a CPU-only reset. */
		int-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;	/* GPIO45 */
	};
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&wdt0 { status = "okay"; };
&trng0 { status = "okay"; };

&esp32_bt_hci {
	status = "okay";
};

/* Enabled in DT as on every other ESP32-S3 board; the driver is only built
 * when CONFIG_WIFI is set, which this board's manifest does not ask for. */
&wifi {
	status = "okay";
};

/* Module flash/PSRAM, declared by the board since Zephyr 4.5 removed the
 * per-module dtsi. */
&flash0 {
	reg = <0x0 DT_SIZE_M(8)>;
	ranges = <0x0 0x0 DT_SIZE_M(8)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};
